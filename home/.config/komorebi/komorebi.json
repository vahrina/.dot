{
  // config n stuff heh
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:KOMOREBI_CONFIG_HOME/applications.json",

  // padding
  "default_workspace_padding": 8,
  "default_container_padding": 4,

  // borders
  "border": true,
  "border_style": "System",
  "border_width": 4,
  "border_offset": -1,

  // misc
  "resize_delta": 350, // wide monitor
  "floating_window_aspect_ratio": "Ultrawide",
  "mouse_follows_focus": true,
  "slow_application_compensation_time": 5,
  "cross_monitor_move_behaviour": "Insert",

  "animation": {
    "enabled": true,
    "duration": 200,
    "fps": 120,
    "style": {
      "movement": "EaseOutCubic"
    }
  },

  "theme": {
    "palette": "Base16",
    "name": "CatppuccinFrappe",
    "unfocused_border": "Base04",
    "single_border": "Base0F",
    "monocle_border": "Base01"
  },

  // aaaaaaall the monitors
  "display_index_preferences": {
    "0": "H1AK500000",
    "1": "6CM3262XTQ"
  },

  "monitors": [
    {
      "workspaces": [
        { "name": "i",   "layout": "Scrolling", "layout_options": { "scrolling": { "columns": 3 } }, },
        { "name": "ii",  "layout": "Scrolling" },
        { "name": "iii", "layout": "Scrolling" }
      ]
    },
    {
      "workspaces": [
        { "name": "top", "layout": "Columns" }
      ]
    }
  ]
}
