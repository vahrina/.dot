{
  // important
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.bar.json",
  "monitor": 1,
  "max_label_width": 1000,

  // font
  "font_size": 20,
  "font_family": "Maple Mono NF Regular",

  // theme
  "theme": {
    "palette": "Base16",
    "name": "CatppuccinFrappe",
    "accent": "Base0D"
  },

  // widgets
  "left_widgets": [
    {
      "Komorebi": {
        "focused_container": {
          "enable": true,
          "display": "Text"
        }
      }
    },
    {
      "Time": {
        "enable": true,
        "label_prefix": "None",
        "format": {
          "Custom": "[%H:%M]>%s %y/%j"
          // %H     %M    %s      %y      %j
          // hour   min   epoch   year    day of year
        }
      }
    }
  ],

  "center_widgets": [
    {
      "Media": {
        "enable": true,
        "display": "Text"
      }
    },
    {
      "Update": {
        "enable": true,
        "data_refresh_interval": 24,
        "label_prefix": "None"
      }
    }
  ],

  "right_widgets": [
    {
      "Cpu": {
        "enable": true,
        "data_refresh_interval": 15,
        "label_prefix": "None"
      }
    },
    {
      "Memory": {
        "enable": true,
        "data_refresh_interval": 15,
        "label_prefix": "None"
      }
    },
    {
      "Network": {
        "enable": true,
        "data_refresh_interval": 60,
        "show_activity": true,
        "show_total_activity": false,
        "label_prefix": "None"
      }
    },
    {
      "Storage": {
        "enable": true,
        "data_refresh_interval": 0,
        "label_prefix": "Text"
      }
    }
  ]
}
