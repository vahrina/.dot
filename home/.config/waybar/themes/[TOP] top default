{
    // --- global config ---
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "margin-top": 4,
    "margin-left": 12,
    "margin-right": 12,
    "height": 28,
    // --- module placement ---
    "modules-left": [
        "cpu",
        "memory",
        "disk",
        "battery",
        "temperature",
        "network",
        "bluetooth",
        "pulseaudio"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "hyprland/window",
        "custom/weather",
        // "hyprland/language", // uncomment for multiple language
        "clock",
        "tray"
    ],
    "hyprland/window": {
        "format": "{}"
    },
    // --- system ---
    "cpu": {
        "format": "<span color='#89b4fa'>󰍛</span> <span color='#cdd6f4'>{usage}%</span>",
        "interval": 3,
        "format-alt-click": "click",
        "format-alt": "<span color='#00FF00'>{icon0}{icon1}{icon2}{icon3}</span> <span color='#FFFFFF'>{usage:>2}%</span> <span color='#00FF00'>󰍛</span>",
        "format-icons": [
            "▁",
            "▂",
            "▃",
            "▄",
            "▅",
            "▆",
            "▇",
            "█"
        ],
        "on-click": "gnome-system-monitor"
    },
    "memory": {
        "interval": 10,
        "format": "<span color='#f38ba8'> </span> <span color='#cdd6f4'>{used:0.1f}G</span>",
        "states": {
            "critical": 90,
            "high": 60,
            "medium": 30
        },
        "rotate": 0,
        "format-critical": " {used}G",
        "format-medium": "󰾅 {used}G",
        "format-high": "󰓅 {used}G",
        "tooltip": true,
        "tooltip-format": "{used:0.1f}G/{total:0.1f}G ({percentage}%)"
    },
    "disk": {
        "interval": 10,
        "path": "/home",
        "format": "<span color='#a6e3a1'> </span><span color='#cdd6f4'>{specific_free:.0f}G</span>",
        "tooltip": true,
        "tooltip-format": "used\t{specific_used:.0f}G\nfree\t{specific_free:.0f}G\ntotal\t{specific_total:.0f}G",
        "unit": "GB"
    },
    "battery": {
        "interval": 60,
        "rotating": 0,
        "format": "{icon} {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "states": {
            "good": 90,
            "warning": 20,
            "critical": 15
        }
    },
    "network": {
        "tooltip": true,
        "format-wifi": " ",
        "tooltip-format": "ssid\t\t<b>{essid}</b>\ninterface\t<b>{ifname}</b>\n~~~~~~~~~~\nsignal\t\t<b>{signalStrength}%</b>\nfrequency\t<b>{frequency}mhz</b>\n~~~~~~~~~~\nip addr\t\t<b>{ipaddr}/{cidr}</b>\ngateway\t\t<b>{gwaddr}</b>\nnetmask\t\t<b>{netmask}</b>",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰖪 ",
        "tooltip-format-disconnected": "disconnected",
        "format-alt": "<span foreground='#99ffdd'> {bandwidthDownBytes}</span> <span foreground='#ffcc66'> {bandwidthUpBytes}</span>",
        "interval": 10
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "bluetooth toggle"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 0%",
        "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1.3 @DEFAULT_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 5%-",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "󱡏",
            "hands-free": "󱡏",
            "headset": "󱡏",
            "default": [
                "",
                ""
            ]
        }
    },
    // --- hyprland related ---
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "6": "",
            "7": "",
            "8": "",
            "9": "",
            "active": "",
            "urgent": "",
            "persistent": "",
            "focused": "",
            "default": ""
        },
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 4
        }
    },
    "hyprland/language": {
        "format": "<span color='#f9e2af'>󰌌</span> <span color='#cdd6f4'>{}</span>",
        "format-en": "en",
        "format-de": "de"
    },
    // --- custom functionality ---
    "custom/weather": {
        "exec": "python3 ~/.config/waybar/scripts/Weather.py",
        "return-type": "json",
        "interval": 120,
        "format": "{text}"
    },
    // --- utility ---
    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "format": " {temperatureC}°C",
        "critical-threshold": 80,
        "tooltip": false
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "<span color='#89b4fa'>󰥔 </span><span color='#cdd6f4'>{:%H:%M %a %d}</span>",
        "format-alt": "{:%d.%m.%Y}"
    },
    "tray": {
        "icon-size": 16,
        "rotate": 0,
        "spacing": 0
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": " Muted",
        "on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1.3 @DEFAULT_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume -l 1.3 @DEFAULT_SOURCE@ 5%-",
        "scroll-step": 5
    }
}
